# Local-only example. Replace the password placeholder; never commit your .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voic_development
DB_USERNAME=voic_app
DB_PASSWORD=replace-with-a-unique-local-app-password
DB_TIMEOUT_MS=3000

# Auth links use this validated application origin, never request headers.
APP_URL=http://127.0.0.1:8443
# Development capture never sends email; messages stay in ignored backend/.tmp/mail/.
MAIL_MODE=capture
MAIL_FROM=VOIC <no-reply@voic.test>
MAIL_CAPTURE_NAME=mail
# For real SMTP configure privately; production requires HTTPS APP_URL/CORS and SMTP.
# MAIL_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-with-provider-user
# SMTP_PASSWORD=replace-with-provider-password
# Inquiry notifications: capture defaults to inquiries@voic.test; SMTP requires a real inbox.
# Keep the actual company inbox and SMTP credentials only in the ignored .env.
INQUIRY_COMPANY_EMAIL=
