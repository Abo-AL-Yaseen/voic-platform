# Local-only example. Replace the password placeholder; never commit your .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voic_development
DB_USERNAME=voic_app
DB_PASSWORD=replace-with-a-unique-local-app-password
DB_TIMEOUT_MS=3000
