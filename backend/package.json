{
  "name": "voic-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc --watch -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "pnpm build && node --watch dist/main.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "db:check": "pnpm build && node dist/database/manage.js check",
    "migration:show": "pnpm build && node dist/database/manage.js show",
    "migration:run": "pnpm build && node dist/database/manage.js run",
    "migration:revert": "pnpm build && node dist/database/manage.js revert",
    "migration:create": "typeorm migration:create",
    "test:database": "pnpm build && node scripts/check-database.mjs",
    "test:compose": "pnpm build && node scripts/check-compose.mjs",
    "catalog:seed": "pnpm build && node dist/catalog/seed-command.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.3"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.11.0"
  },
  "packageManager": "pnpm@10.23.0"
}
