# Uninstalled template. Replace host, release paths and certificate paths, then nginx -t.
server {
    listen 443 ssl;
    server_name REPLACE_WITH_APPROVED_HOST;
    ssl_certificate /etc/voic/tls/fullchain.pem;
    ssl_certificate_key /etc/voic/tls/privkey.pem;
    root /srv/voic/current/frontend/dist;
    index index.html;
    client_max_body_size 7m;
    add_header X-Content-Type-Options nosniff always;
    # Keep closed until company/legal approval and public-origin configuration are verified.
    add_header X-Robots-Tag "noindex, nofollow" always;
    # Default logs contain token-bearing query strings: do not enable them without redaction.
    access_log off;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite incoming forwarded values. Never append an attacker-supplied client chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }
    location ~ (^|/)(\.|src/|backend/|docs/|node_modules/|deploy/) { return 404; }
    location ~* \.(env|sql|dump|pem|key|map)$ { return 404; }
    location ~ ^/assets/.+-[A-Za-z0-9_-]{8}\.(js|css)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }
    location ~* \.(png|jpe?g|webp|svg|ttf|woff2?|css|js|txt|ico)$ {
        try_files $uri =404;
        expires 1d;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
}
